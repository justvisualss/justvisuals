const paletteGrid = document.getElementById('palette-grid');
const paletteName = document.getElementById('palette-name');
const gradientSurface = document.getElementById('gradient-surface');
const generateBtn = document.getElementById('generate-palette');
const copyBtn = document.getElementById('copy-all');
const shuffleBtn = document.getElementById('shuffle-layout');
const metricValue = document.getElementById('metric-value');
const metricContrast = document.getElementById('metric-contrast');

const paletteNames = [
  'Aurora Blend',
  'Solar Field',
  'Velvet Horizon',
  'Lunar Tide',
  'Cinder Bloom',
  'Coastline Glow',
  'Emerald Echo',
  'Neon Drift'
];

const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

function hslToHex(h, s, l) {
  s /= 100;
  l /= 100;

  const c = (1 - Math.abs(2 * l - 1)) * s;
  const x = c * (1 - Math.abs((h / 60) % 2 - 1));
  const m = l - c / 2;
  let r = 0;
  let g = 0;
  let b = 0;

  if (0 <= h && h < 60) {
    r = c; g = x; b = 0;
  } else if (60 <= h && h < 120) {
    r = x; g = c; b = 0;
  } else if (120 <= h && h < 180) {
    r = 0; g = c; b = x;
  } else if (180 <= h && h < 240) {
    r = 0; g = x; b = c;
  } else if (240 <= h && h < 300) {
    r = x; g = 0; b = c;
  } else {
    r = c; g = 0; b = x;
  }

  const toHex = (value) => {
    const hex = Math.round((value + m) * 255).toString(16);
    return hex.padStart(2, '0');
  };

  return `#${toHex(r)}${toHex(g)}${toHex(b)}`.toUpperCase();
}

function generatePalette() {
  const baseHue = Math.random() * 360;
  const saturation = 68 + Math.random() * 18;
  const lightness = 52 + Math.random() * 12;

  const palette = Array.from({ length: 5 }, (_, index) => {
    const hue = (baseHue + index * 32 + Math.random() * 20) % 360;
    const hueShift = clamp(hue, 0, 359);
    const adjustedLightness = clamp(lightness + (index - 2) * 4, 38, 72);
    return hslToHex(hueShift, saturation, adjustedLightness);
  });

  return palette;
}

function randomizeLayout() {
  const cards = [...document.querySelectorAll('.palette-card')];
  cards.forEach((card, index) => {
    const rotation = (Math.random() * 6 - 3).toFixed(1);
    const delay = index * 35;
    card.style.transform = `rotate(${rotation}deg)`;
    card.style.transitionDelay = `${delay}ms`;
  });

  setTimeout(() => {
    cards.forEach((card) => {
      card.style.transform = 'rotate(0deg)';
    });
  }, 220);
}

function updatePalette(palette) {
  paletteGrid.innerHTML = '';

  palette.forEach((color, index) => {
    const card = document.createElement('button');
    card.type = 'button';
    card.className = 'palette-card';
    card.setAttribute('aria-label', `Copy color ${color}`);
    card.innerHTML = `
      <span class="swatch" style="background:${color};"></span>
      <div class="swatch-meta">
        <strong>${color}</strong>
        <span>0${index + 1}</span>
      </div>
    `;

    card.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(color);
        card.classList.add('copied');
        card.title = `Copied ${color}`;
        setTimeout(() => card.classList.remove('copied'), 700);
      } catch (error) {
        card.title = 'Copy unavailable';
      }
    });

    paletteGrid.appendChild(card);
  });

  const [first, second, third, fourth, fifth] = palette;
  const gradient = `linear-gradient(135deg, ${first}, ${second}, ${third}, ${fourth}, ${fifth})`;
  gradientSurface.style.background = gradient;
  document.documentElement.style.setProperty('--color-one', first);
  document.documentElement.style.setProperty('--color-two', second);
  document.documentElement.style.setProperty('--color-three', third);
  document.documentElement.style.setProperty('--color-four', fourth);
  document.documentElement.style.setProperty('--color-five', fifth);

  paletteName.textContent = paletteNames[Math.floor(Math.random() * paletteNames.length)];
  const engagement = `${Math.floor(80 + Math.random() * 18)}%`;
  metricValue.textContent = engagement;
  metricContrast.textContent = Math.random() > 0.5 ? 'High' : 'Bold';
}

async function copyPalette() {
  const colors = [...document.querySelectorAll('.swatch-meta strong')]
    .map((node) => node.textContent)
    .join(', ');

  try {
    await navigator.clipboard.writeText(colors);
    copyBtn.textContent = 'Copied';
    setTimeout(() => {
      copyBtn.textContent = 'Copy palette';
    }, 800);
  } catch (error) {
    copyBtn.textContent = 'Unavailable';
  }
}

generateBtn.addEventListener('click', () => {
  updatePalette(generatePalette());
});

copyBtn.addEventListener('click', copyPalette);
shuffleBtn.addEventListener('click', randomizeLayout);

updatePalette(generatePalette());
